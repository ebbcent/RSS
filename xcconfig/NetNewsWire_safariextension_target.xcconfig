#include "./common/NetNewsWire_macextension_common.xcconfig"
CODE_SIGN_ENTITLEMENTS = Mac/SafariExtension/Subscribe_to_Feed.entitlements
INFOPLIST_FILE = Mac/SafariExtension/Info.plist
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks
// VIGIE: préfixé par l'identifiant de l'app (exigence Apple).
PRODUCT_BUNDLE_IDENTIFIER = fr.ebbcent.Vigie$(BUNDLE_ID_SUFFIX).SubscribeToFeed
