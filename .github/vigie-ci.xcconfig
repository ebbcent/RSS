// VIGIE: réglages de compilation sur GitHub Actions (aucun compte Apple).
// Signature « ad hoc » (Sign to Run Locally) : suffisant pour lancer l'app sur son propre Mac.
CODE_SIGNING_ALLOWED = YES
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
ORGANIZATION_IDENTIFIER = fr.ebbcent
DEVELOPER_ENTITLEMENTS = -dev
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) *.applescript
